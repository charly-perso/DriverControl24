@page "/files"
@inject ConfigService Cfg
@inject Loc L

<PageTitle>@L["title.files"]</PageTitle>

<h1>@L["files.h1"]</h1>

<section class="card">
    <h2>@L["files.backups"]</h2>
    <p class="muted">@L["files.backups.help"]</p>
    @if (_message != null)
    {
        <p class="@(_isError ? "bad" : "ok")">@_message</p>
    }
    @if (_backups.Count == 0)
    {
        <p class="muted">@L["files.nobackup"]</p>
    }
    else
    {
        <table class="grid">
            <thead><tr><th>@L["files.col.date"]</th><th>@L["files.col.size"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var b in _backups)
                {
                    <tr>
                        <td>@b.TimestampUtc.ToLocalTime().ToString("G")</td>
                        <td>@(b.Size / 1024) @L["files.size.unit"]</td>
                        <td class="c">
                            <button class="btn sm" @onclick="() => Restore(b.FileName)">@L["files.restore"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="card">
    <h2>@L["files.content"] <small>@L["files.readonly"]</small></h2>
    <div class="actions">
        <button class="btn" @onclick="Refresh">@L["files.refresh"]</button>
        <button class="btn" @onclick="Cfg.Reload">@L["files.reload"]</button>
    </div>
    <pre class="raw">@_raw</pre>
</section>

@code {
    private List<BackupInfo> _backups = [];
    private string _raw = "";
    private string? _message;
    private bool _isError;

    protected override void OnInitialized() => Refresh();

    private void Refresh()
    {
        _backups = Cfg.GetBackups();
        _raw = Cfg.ReadRaw();
    }

    private void Restore(string fileName)
    {
        try
        {
            Cfg.RestoreBackup(fileName);
            _message = Loc.T("files.restored");
            _isError = false;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        Refresh();
    }
}
