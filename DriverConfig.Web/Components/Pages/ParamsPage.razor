@page "/params"
@inject ConfigService Cfg
@inject NavigationManager Nav
@inject Loc L

<PageTitle>@L["title.params"]</PageTitle>

<h1>@L["nav.params"]</h1>

<div class="toolbar">
    <label for="plugin"><strong>Plugin</strong></label>
    <select id="plugin" value="@_plugin" @onchange="OnPluginChanged">
        <option value="">@L["params.choose"]</option>
        @foreach (var p in _plugins)
        {
            <option value="@p">@p</option>
        }
    </select>
    @if (_plugin != "")
    {
        <span class="count">@Loc.T("params.lines", _rows.Count, PageCount)</span>
    }
</div>

@if (_plugin == "")
{
    <p class="muted">@L["params.intro"]</p>
}
else
{
    <section class="preview" aria-label="@L["params.preview.aria"]">
        <div class="preview-head">
            <strong>@L["params.preview"]</strong>
            <small>@L["params.preview.help"]</small>
            <span class="spacer"></span>
            <button class="btn sm" disabled="@(_page == 0)" @onclick="() => _page--">◀</button>
            <span>@Loc.T("params.page", _page + 1, PageCount)</span>
            <button class="btn sm" disabled="@(_page >= PageCount - 1)" @onclick="() => _page++">▶</button>
        </div>
        <div class="strips">
            @for (int i = 0; i < 24; i++)
            {
                int pos = _page * 24 + i;
                var r = pos < _rows.Count ? _rows[pos] : null;
                <div class="strip @(r == null ? "empty" : null) @(r != null && !r.IsText && !r.Visible ? "hid" : null) @(r is { IsText: true } ? "txt" : null) @(r != null && LongNameMode.IsLinkedSeparator(_rows, pos) ? "linkL" : null) @(r != null && LongNameMode.IsLong(_rows, pos) ? "linkR" : null)">
                    <span class="lcd">@(r == null ? "" : r.IsText ? Clip(r.Text, 8) : Clip(r.ShortName, 4))</span>
                    <span class="lcd2">@(r == null || r.IsText ? "" : Clip(r.LongName, 8))</span>
                </div>
            }
        </div>
    </section>

    <div class="table-wrap">
        <table class="grid">
            <thead>
                <tr>
                    <th></th>
                    <th class="c">#</th>
                    <th>@L["params.col.param"]</th>
                    <th>@L["params.col.short"] <small>(4)</small></th>
                    <th>@L["params.col.long"] <small>(8)</small></th>
                    <th class="c">@L["col.visible"]</th>
                    <th class="c" title="@L["params.col.display.help"]">@L["params.col.display"]</th>
                    <th class="c">@L["params.col.order"]</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < _rows.Count; i++)
                {
                    int idx = i;
                    var r = _rows[i];
                    <tr draggable="true"
                        class="@(r.IsText ? "textrow" : null) @(_dragOver == idx ? "dragover" : null) @(!r.IsText && !r.Visible ? "dim" : null) @(LongNameMode.IsLinkedSeparator(_rows, idx) ? "linkTop" : null) @(LongNameMode.IsLong(_rows, idx) ? "linkBot" : null)"
                        @ondragstart="() => _drag = idx"
                        @ondragover="() => _dragOver = idx"
                        @ondragover:preventDefault
                        @ondragleave="() => { if (_dragOver == idx) _dragOver = -1; }"
                        @ondrop="() => Drop(idx)"
                        @ondragend="() => { _drag = -1; _dragOver = -1; }"
                        @key="r.Id">
                        <td class="handle" title="@(LongNameMode.IsLinkedSeparator(_rows, idx) || LongNameMode.IsLong(_rows, idx) ? L["params.drag.linked"] : L["params.drag"])">⠿</td>
                        <td class="c">@(r.IsText ? "T" : r.ParamIndex)</td>
                        @if (r.IsText)
                        {
                            <td colspan="3">
                                <input class="text" placeholder="@L["params.text.placeholder"]" maxlength="@(LongNameMode.IsLinkedSeparator(_rows, idx) ? 4 : 64)"
                                       value="@r.Text" @oninput="e => LongNameMode.EditSeparatorText(_rows, idx, e.Value?.ToString() ?? string.Empty)" />
                            </td>
                            <td class="c"><button class="btn sm" title="@L["params.text.remove"]" @onclick="() => Remove(idx)">✕</button></td>
                            <td></td>
                        }
                        else
                        {
                            <td class="name" title="@r.FullName">@r.FullName</td>
                            <td><input class="short @(Warn(r.ShortName) ? "warn" : null)" maxlength="4" size="5"
                                       value="@r.ShortName" @oninput="e => LongNameMode.EditShortName(_rows, idx, e.Value?.ToString() ?? string.Empty)" /></td>
                            <td><input class="short @(Warn(r.LongName) ? "warn" : null)" maxlength="8" size="9"
                                       value="@r.LongName" @oninput="e => OnLongInput(idx, e.Value?.ToString() ?? string.Empty)" /></td>
                            <td class="c"><input type="checkbox" @bind="r.Visible" aria-label="@L["col.visible"]" /></td>
                            <td class="c nowrap modes">
                                @{ bool isLong = LongNameMode.IsLong(_rows, idx); }
                                <label><input type="radio" name="mode-@r.Id" checked="@(!isLong)" @onchange="() => SetShort(idx)" /> @L["params.mode.short"]</label>
                                <label title="@(LongNameMode.CanBeLong(r) ? null : L["params.mode.long.help"])">
                                    <input type="radio" name="mode-@r.Id" checked="@isLong" disabled="@(!isLong && !LongNameMode.CanBeLong(r))"
                                           @onchange="() => SetLong(idx)" /> @L["params.mode.long"]</label>
                            </td>
                        }
                        <td class="c nowrap">
                            <button class="btn sm" disabled="@(!CanMove(idx, -1))" @onclick="() => Move(idx, -1)" aria-label="@L["params.up"]">▲</button>
                            <button class="btn sm" disabled="@(!CanMove(idx, 1))" @onclick="() => Move(idx, 1)" aria-label="@L["params.down"]">▼</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="savebar">
        <button class="btn" @onclick="AddText">@L["params.addtext"]</button>
        <button class="btn" @onclick="ShowAll">@L["params.showall"]</button>
        @if (_rows.Any(r => !r.IsText && (Warn(r.ShortName) || Warn(r.LongName))))
        {
            <span class="warnmsg">@L["params.nonascii"]</span>
        }
        @if (_message != null)
        {
            <span class="@(_isError ? "bad" : "ok")">@_message</span>
        }
        <span class="spacer"></span>
        <button class="btn" disabled="@(!IsDirty)" @onclick="Load">@L["btn.cancel"]</button>
        <button class="btn primary" disabled="@(!IsDirty)" @onclick="Save">@L["btn.save"]</button>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "plugin")] public string? PluginQuery { get; set; }

    private List<string> _plugins = [];
    private string _plugin = "";
    private List<ParamEdit> _rows = [];
    private List<ParamEdit> _orig = [];
    private int _page, _drag = -1, _dragOver = -1;
    private string? _message;
    private bool _isError;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_rows.Count / 24.0));
    private bool IsDirty => _rows.Count != _orig.Count || _rows.Where((r, i) => !r.SameContent(_orig[i])).Any();

    protected override void OnInitialized() => _plugins = Cfg.GetPluginsWithParams();

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(PluginQuery) && PluginQuery != _plugin && _plugins.Contains(PluginQuery))
        {
            _plugin = PluginQuery;
            Load();
        }
    }

    private void OnPluginChanged(ChangeEventArgs e)
    {
        _plugin = e.Value?.ToString() ?? "";
        Nav.NavigateTo(_plugin == "" ? "params" : "params?plugin=" + Uri.EscapeDataString(_plugin));
        Load();
    }

    private void Load()
    {
        _rows = _plugin == "" ? [] : Cfg.GetParams(_plugin);
        _orig = _rows.Select(r => r.Clone()).ToList();
        _page = 0;
        _message = null;
    }

    // Un paramètre en mode Long se déplace avec son séparateur texte (voir LongNameMode.BlockRange).
    private void Move(int idx, int delta) => LongNameMode.MoveBlock(_rows, idx, delta);

    private bool CanMove(int idx, int delta)
    {
        var (start, count) = LongNameMode.BlockRange(_rows, idx);
        return delta < 0 ? start > 0 : start + count < _rows.Count;
    }

    private void Drop(int target)
    {
        int from = _drag;
        _drag = _dragOver = -1;
        if (from < 0 || from == target || from >= _rows.Count) return;
        LongNameMode.DropBlock(_rows, from, target);
    }

    private void Remove(int idx) => _rows.RemoveAt(idx);

    private void SetLong(int idx) => LongNameMode.SetLong(_rows, idx);

    private void SetShort(int idx) => LongNameMode.SetShort(_rows, idx);

    private void OnLongInput(int idx, string value) => LongNameMode.EditLongName(_rows, idx, value);

    private void AddText()
    {
        _rows.Add(new ParamEdit { ParamIndex = -1, Visible = false, Text = "" });
        _page = PageCount - 1;
    }

    private void ShowAll()
    {
        foreach (var r in _rows.Where(r => !r.IsText)) r.Visible = true;
    }

    private static bool Warn(string s) => s.Any(c => c > 126 || c < 32);

    private static string Clip(string s, int n) => s.Length <= n ? s : s[..n];

    private void Save()
    {
        try
        {
            Cfg.SaveParams(_plugin, _rows);
            Load();
            _message = Loc.T("msg.saved");
            _isError = false;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }
}
