@page "/"
@implements IDisposable
@inject ConfigService Cfg
@inject Loc L

<PageTitle>@L["title.driver"]</PageTitle>

<h1>Driver</h1>

<section class="card">
    <label class="row">
        <input type="checkbox" @bind="_autostart" />
        <span>
            <strong>@L["driver.autostart"]</strong>
            <small>@L["driver.autostart.help"]</small>
        </span>
    </label>

    <label class="row">
        <input type="checkbox" @bind="_vsDebug" />
        <span>
            <strong>@L["driver.vsdebug"]</strong>
            <small>@L["driver.vsdebug.help"]</small>
        </span>
    </label>

    <div class="field">
        <label for="nic"><strong>@L["driver.nic"]</strong></label>
        <div class="nicrow">
        <select id="nic" @bind="_nic">
            @if (!_known.Contains(_nic))
            {
                <option value="@_nic">@(_nic == "" ? L["driver.nic.none"] : _nic) — @L["driver.nic.missing"]</option>
            }
            <option value="TestWithoutC24">@L["driver.nic.test"]</option>
            @foreach (var nic in _all.Where(n => n != "TestWithoutC24"))
            {
                <option value="@nic">@nic</option>
            }
        </select>
        <button type="button" class="btn sm" title="@L["driver.nic.refresh.help"]" @onclick="Cfg.RefreshInterfaces">⟳ @L["driver.nic.refresh"]</button>
        </div>
        @if (!_known.Contains(_nic))
        {
            <small class="bad">@L["driver.nic.unknown"]</small>
        }
        else if (_nic == "TestWithoutC24")
        {
            <small>@L["driver.nic.simulation"]</small>
        }
    </div>

    <div class="actions">
        <button class="btn primary" disabled="@(!IsDirty)" @onclick="Save">@L["btn.save"]</button>
        <button class="btn" disabled="@(!IsDirty)" @onclick="Load">@L["btn.cancel"]</button>
        @if (_message != null)
        {
            <span class="@(_isError ? "bad" : "ok")">@_message</span>
        }
    </div>
</section>

@code {
    private bool _autostart, _vsDebug;
    private string _nic = "";
    private DriverSettings _orig = default!;
    private HashSet<string> _known = new();
    private IReadOnlyList<string> _all = [];
    private string? _message;
    private bool _isError;

    private bool IsDirty => _autostart != _orig.Autostart || _vsDebug != _orig.VsDebug || _nic != _orig.NetworkInterface;

    protected override void OnInitialized()
    {
        Cfg.Changed += OnExternal;
        Cfg.InterfacesChanged += OnInterfaces;
        Load();
    }

    private void Load()
    {
        _orig = Cfg.GetDriver();
        _autostart = _orig.Autostart;
        _vsDebug = _orig.VsDebug;
        _nic = _orig.NetworkInterface;
        _all = _orig.Interfaces;
        _known = new HashSet<string>(_all) { "TestWithoutC24" };
        _message = null;
    }

    private void Save()
    {
        try
        {
            Cfg.SaveDriver(_autostart, _vsDebug, _nic);
            Load();
            _message = Loc.T("msg.saved");
            _isError = false;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }

    // Après un enregistrement ou un rechargement venant d'ailleurs : on ne remplace le brouillon que s'il est propre.
    private void OnExternal() => InvokeAsync(() =>
    {
        if (!IsDirty && !Cfg.ExternalChange)
        {
            var (msg, err) = (_message, _isError);
            Load();
            (_message, _isError) = (msg, err);
            StateHasChanged();
        }
    });

    // Liste des interfaces relue : on met à jour la liste sans toucher au brouillon (choix en cours conservé).
    private void OnInterfaces() => InvokeAsync(() =>
    {
        _all = Cfg.GetDriver().Interfaces;
        _known = new HashSet<string>(_all) { "TestWithoutC24" };
        StateHasChanged();
    });

    public void Dispose()
    {
        Cfg.Changed -= OnExternal;
        Cfg.InterfacesChanged -= OnInterfaces;
    }
}
