@inherits LayoutComponentBase
@implements IDisposable
@inject ConfigService Cfg
@inject Loc L

<header class="topbar">
    <div class="brand">Control<span>24</span> <small>Config</small></div>
    <nav>
        <NavLink href="" Match="NavLinkMatch.All">Driver</NavLink>
        <NavLink href="plugins">Plugins</NavLink>
        <NavLink href="params">@L["nav.params"]</NavLink>
        <NavLink href="files">@L["nav.files"]</NavLink>
    </nav>
    <div class="file" title="@Cfg.IniPath">@Cfg.IniPath</div>
</header>

@if (Cfg.ExternalChange)
{
    <div class="banner warn" role="alert">
        <span>@L["banner.external"]</span>
        <button class="btn" @onclick="Cfg.Reload">@L["btn.reload"]</button>
    </div>
}

<main>
    @if (!Cfg.Available)
    {
        <div class="banner err">@Cfg.LastError</div>
    }
    else
    {
        @* La clé recrée la page après un rechargement : les brouillons sont alors repris depuis le disque. *@
        <div @key="_version">@Body</div>
    }
</main>

<div id="blazor-error-ui" data-nosnippet>
    @L["ui.error"]
    <a href="." class="reload">@L["btn.reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private int _version;

    protected override void OnInitialized()
    {
        Cfg.Changed += OnChanged;
        Cfg.Reloaded += OnReloaded;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnReloaded() => InvokeAsync(() => { _version++; StateHasChanged(); });

    public void Dispose()
    {
        Cfg.Changed -= OnChanged;
        Cfg.Reloaded -= OnReloaded;
    }
}
